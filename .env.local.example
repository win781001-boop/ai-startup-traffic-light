# ─── AI創業紅綠燈 — 環境變數模板 ───
#
# 複製此檔案為 .env.local，填入對應的值：
#   cp .env.local.example .env.local
#
# ⚠️ 警告：
#   - 此檔案只放 variable 名稱與說明，不放任何真實 secret。
#   - .env.local 已加入 .gitignore，絕對不可 commit。
#   - 所有 key/token 只存在開發者本機的 .env.local 與 Vercel Environment Variables。

# ═══════════════════════════════════════════
# 基礎 app / DB
# ═══════════════════════════════════════════

# Neon PostgreSQL connection string（production / preview / local 各自用不同 DB）
DATABASE_URL=

# 本站根網址，用於組 NotifyURL / ReturnURL
# production 建議設為 https://aistartuplight.com
# 未設定時會依序 fallback: VERCEL_URL → localhost:3000
APP_BASE_URL=

# Node.js 執行環境（production / development / test）
# Vercel production 會自動設為 production，local 通常不須手動設定
NODE_ENV=

# ═══════════════════════════════════════════
# AI / DeepSeek
# ═══════════════════════════════════════════

# OpenAI API key（production 必填；未設或為預設值時回傳 mock 結果）
OPENAI_API_KEY=

# API base URL（可選，預設 https://api.openai.com/v1）
# 使用 DeepSeek 或其他相容 API 時改為對應網址
OPENAI_BASE_URL=

# 模型名稱（可選，預設 gpt-4o-mini）
OPENAI_MODEL=

# ═══════════════════════════════════════════
# Tavily 搜尋（可選）
# ═══════════════════════════════════════════

# Tavily Search API key
# 未設定或為預設值時靜默跳過搜尋，AI 僅依賴使用者輸入推估 marketSignals
TAVILY_API_KEY=

# Tavily daily API usage limit
# production 建議設為 50（2026-06-17 incident 後）
# 未設定時預設 300
TAVILY_DAILY_LIMIT=

# Public Beta 期間每次 submit-analysis 的 Tavily 搜尋次數
# 未設定時預設 3
# Public Beta 關閉後此值無效
# 前端無使用，只影響 submit-analysis 後端
PUBLIC_BETA_TAVILY_QUERY_LIMIT=

# ═══════════════════════════════════════════

# ═══════════════════════════════════════════
# Public Beta（可選，上線後應移除）
# ═══════════════════════════════════════════

# 是否啟用 Public Beta 模式（true / false）
# 啟用時允許無 paymentId 自動建立 0 元 beta_free 紀錄
# production 上線後應設為 false 或移除
PUBLIC_BETA=

# 前端是否隱藏付款流程（true / false）
# build-time env，修改後需 redeploy
NEXT_PUBLIC_PUBLIC_BETA=

# Public Beta 結束日期顯示（僅 UI 用途，不自動切換金流）
# 格式：YYYY-MM-DD
NEXT_PUBLIC_BETA_END_DATE=

# ═══════════════════════════════════════════
# Public Beta daily limits（選用，僅公測期間有效）
# ═══════════════════════════════════════════

# Public Beta 每日全域 accepted analysis 上限
# 達到此上限後回 429，不再接收新 submission
# 無 Upstash 時使用 memory fallback，serverless 下不可靠
BETA_DAILY_ANALYSIS_LIMIT=

# Public Beta 每日每 IP accepted analysis 上限
# 達到此上限後回 429
# 無 Upstash 時使用 memory fallback，serverless 下不可靠
BETA_DAILY_IP_LIMIT=

# Internal auth
# ═══════════════════════════════════════════

# 用於保護 /api/analyze-idea 不被外部直接呼叫的共享 secret
# production 必須設定（缺失時 verifyInternalRequest 永遠回 false，判燈流程中斷）
# local/dev 可不設定（自動放行）
INTERNAL_API_SECRET=

# --- Internal API bypass (debug only) ---
# When INTERNAL_API_SECRET is not set and NODE_ENV is not production,
# setting this to "true" bypasses the x-internal-secret check.
# NOT allowed in production (ignored). Defaults to off.
ALLOW_INTERNAL_API_BYPASS=

# ═══════════════════════════════════════════
# Rate limit / Upstash
# ═══════════════════════════════════════════

# Upstash Redis REST endpoint 與 token
# production 必須同時設定兩者，rate limit 才能跨 serverless instance 生效
# local/dev 可不設定（自動使用 memory fallback，只對單一 instance 有效）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ═══════════════════════════════════════════
# Payment provider
# ═══════════════════════════════════════════

# 付款 provider 選擇：mock | newebpay | ecpay
# local/dev 可用 mock（既有流程）
# production 目前不可設 newebpay — 需等藍新 sandbox E2E 人工認證完成後才能切換
PAYMENT_PROVIDER=

# ═══════════════════════════════════════════
# NewebPay（正式金流用）
# ═══════════════════════════════════════════
#
# ⚠️ 目前 sandbox E2E 仍因藍新會員 / 商店後台人工認證 pending 暫停。
#    以下變數請在人工認證完成後再設定，不可在 sandbox E2E 通過前設定。

# 藍新商店代號
NEWEBPAY_MERCHANT_ID=

# AES-256-CBC 加密金鑰（32 字元）
NEWEBPAY_HASH_KEY=

# AES-256-CBC 加密 IV（16 字元）
NEWEBPAY_HASH_IV=

# MPG 閘道網址（測試環境或正式環境）
NEWEBPAY_MPG_URL=

# ═══════════════════════════════════════════
# ECPay（綠界金流用）
# ═══════════════════════════════════════════
#
# 以下變數在設定 PAYMENT_PROVIDER=ecpay 時必須全部填入。

# 綠界商店代號
# 測試可用 2000133（綠界測試 MerchantID）
ECPAY_MERCHANT_ID=

# HashKey（綠界後台取得，用於 CheckMacValue 計算）
ECPAY_HASH_KEY=

# HashIV（綠界後台取得，用於 CheckMacValue 計算）
ECPAY_HASH_IV=

# AioCheckOut 閘道網址
# 測試環境：https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
# 正式環境：https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5
ECPAY_CHECKOUT_URL=
