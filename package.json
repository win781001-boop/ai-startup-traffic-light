{
  "name": "ai-startup-traffic-light",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test:rate-limit": "npx tsx lib/rate-limit.test.ts",
    "test:newebpay:crypto": "node scripts/newebpay-crypto-test.mjs",
    "test:newebpay:provider": "node scripts/newebpay-provider-test.mjs",
    "test:newebpay:verify-callback": "node scripts/newebpay-verify-callback-test.mjs",
    "test:unit": "npx tsx lib/internal-auth.test.ts && npx tsx lib/rate-limit.test.ts && node scripts/newebpay-crypto-test.mjs && node scripts/newebpay-provider-test.mjs && node scripts/newebpay-verify-callback-test.mjs",
    "test:submit-flow": "powershell -File scripts/test-submit-flow.ps1",
    "test:payment-webhook": "powershell -File scripts/test-payment-webhook.ps1",
    "test:payment-status": "node scripts/test-payment-status.mjs",
    "test:newebpay:webhook": "powershell -File scripts/test-newebpay-webhook.ps1",
    "test:create-payment:newebpay": "powershell -File scripts/test-create-payment-newebpay.ps1",
    "test:payment-panel:newebpay": "powershell -File scripts/test-payment-panel-newebpay.ps1",
    "test:internal-auth": "npx tsx lib/internal-auth.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
