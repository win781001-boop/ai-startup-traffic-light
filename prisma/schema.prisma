generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Payment {
  id        String    @id
  status    String    @default("pending")
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  // ─── Real payment provider fields (Phase 2A) ───
  // amountTwd: 應收款金額（TWD），用於 webhook 金額核對
  // providerName: 處理此付款的金流 provider（目前預設 mock）
  // providerPaymentId: 金流 provider 端的訂單編號（真金流後使用）
  // providerRawResponse: provider create-order 原始回傳（客服除錯／對帳用）
  amountTwd           Int     @default(49)
  providerName        String  @default("mock")
  providerPaymentId   String?
  providerRawResponse String?

  submissions Submission[]
  analyses    Analysis[]
}

model Submission {
  id           String   @id
  paymentId    String
  status       String   @default("submitted")
  idea         String
  targetUser   String
  problem      String
  pricing      String
  firstVersion String
  buildTime    String
  createdAt    DateTime @default(now())

  payment  Payment   @relation(fields: [paymentId], references: [id])
  analysis Analysis?
}

model Analysis {
  id            String    @id
  submissionId  String    @unique
  paymentId     String
  status        String    @default("submitted")
  used          Boolean   @default(false)
  signal        String?
  hasSignal     Boolean   @default(false)
  aiRawResponse String?
  errorReason   String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  attemptCount  Int       @default(0)
  maxAttempts   Int       @default(3)

  submission Submission @relation(fields: [submissionId], references: [id])
  payment    Payment    @relation(fields: [paymentId], references: [id])
}

model ErrorReport {
  id                  String   @id @default(cuid())
  analysisId          String
  paymentId           String   @unique
  issueType           String
  email               String
  screenshotUrl       String
  screenshotMimeType  String
  screenshotSizeBytes Int
  createdAt           DateTime @default(now())
}

model Feedback {
  id         String   @id @default(cuid())
  analysisId String
  paymentId  String
  value      String
  createdAt  DateTime @default(now())
}
model PaymentWebhookLog {
  id                String    @id @default(cuid())
  paymentId         String?
  providerName      String
  providerEventId   String?
  providerPaymentId String?
  dedupeKey         String    @unique
  eventType         String
  rawPayload        String
  verified          Boolean   @default(false)
  verifiedAt        DateTime?
  signatureValid    Boolean?
  amountMatch       Boolean?
  processed         Boolean   @default(false)
  processedAt       DateTime?
  errorMessage      String?
  createdAt         DateTime  @default(now())

  @@index([paymentId])
  @@index([providerName])
  @@index([providerPaymentId])
  @@index([createdAt])
}
